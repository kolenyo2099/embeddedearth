# EmbeddedEarth Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GOOGLE EARTH ENGINE
# =============================================================================
# Your Google Cloud Project ID with Earth Engine API enabled
# Get this from: https://console.cloud.google.com
# Required for fetching satellite imagery
GEE_PROJECT_ID=your-project-id-here

# =============================================================================
# COMPUTE RESOURCES
# =============================================================================
# Set to "true" to use GPU acceleration (requires CUDA-capable GPU)
# Set to "false" to use CPU (slower but works everywhere)
USE_GPU=false

# =============================================================================
# HUGGING FACE (Optional)
# =============================================================================
# Hugging Face API token for downloading gated models
# Get this from: https://huggingface.co/settings/tokens
# Only needed if you're using gated models
# HF_TOKEN=your_huggingface_token_here

# =============================================================================
# MODEL CONFIGURATION (Optional)
# =============================================================================
# Override default model cache directory (optional)
# MODELS_CACHE_DIR=/path/to/model/cache

# Override default data cache directory (optional)
# DATA_CACHE_DIR=/path/to/data/cache
